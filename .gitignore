# Multi-catalog layout
# Shared benchmark datasets are downloaded by users, not committed. Keep the
# per-env directory layout (via .gitkeep placeholders) so users know where to
# place the downloaded datasets.
shared/data/datasets/**
!shared/data/datasets/**/
!shared/data/datasets/**/.gitkeep
# Catalog outputs: commit the JSON / codegen result artifacts (the raw paper
# results); ignore regenerable intermediates (run logs, MC rollout caches,
# archives).
catalogs/*/data/**/rollouts/
catalogs/*/data/**/*.jsonl
catalogs/*/data/**/*.log
catalogs/*/data/**/*.pkl
catalogs/*/data/**/*.zip
# Old / non-benchmark cruft, parked locally out of the repo.
legacy/
